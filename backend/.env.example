# AI Cyber Investigation Assistant Environment Configuration

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cyber_investigation?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cyber_investigation

# Groq Cloud API Key (Server-Side Only - Never exposed to frontend)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tesseract OCR Executable Path (Windows standard installation path)
# Download from: https://github.com/UB-Mannheim/tesseract/wiki
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Evidence Storage Directory
EVIDENCE_VAULT_DIR=./data/evidence_vault

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Environment (development / production)
ENVIRONMENT=development
